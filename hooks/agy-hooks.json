{
  "ecc-pre-tool-use": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file|find_by_name|grep_search|list_dir|call_mcp_tool",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/agy/pre-tool-use.js", "timeout": 10 }]
      }
    ]
  },
  "ecc-post-tool-use": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/agy/post-tool-use.js", "timeout": 45 }]
      }
    ]
  },
  "ecc-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hooks/agy/pre-invocation.js",
        "timeout": 15
      }
    ]
  },
  "ecc-post-invocation": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node scripts/hooks/agy/post-invocation.js",
        "timeout": 30
      }
    ]
  },
  "ecc-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hooks/agy/stop.js",
        "timeout": 300
      }
    ]
  }
}
